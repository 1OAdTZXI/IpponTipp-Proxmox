[Unit]
Description=IpponTipp Celery worker
After=network-online.target mariadb.service redis-server.service
Wants=network-online.target
Requires=mariadb.service redis-server.service

[Service]
Type=simple
User=ippontipp
Group=ippontipp
WorkingDirectory=/opt/ippontipp/current
Environment=DJANGO_ENV=prod
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/ippontipp/app.env
ExecStart=/opt/ippontipp/current/.venv/bin/python -m celery -A IpponTipp worker --loglevel=INFO --concurrency=2
Restart=on-failure
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
